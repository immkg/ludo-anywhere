# Postgres connection string. Provision with Railway's "Add Postgres" plugin
# in production (it injects DATABASE_URL automatically); for local dev, point
# at any Postgres instance (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`).
DATABASE_URL="postgresql://user:password@localhost:5432/ludo"

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Add these authorized redirect URIs:
#   http://localhost:3001/api/auth/callback/google   (local dev)
#   https://<your-domain>/api/auth/callback/google   (production)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Session/JWT signing secret. Generate with: openssl rand -base64 33
AUTH_SECRET=""

# Required — this app runs a custom Node server (server.js), not `next dev`/
# `next start` directly, and Next can't reliably derive its own origin from
# the raw request in that setup. Without this, Auth.js builds OAuth
# redirect/callback URLs from whatever Next falls back to internally, not
# the real one — breaking Google sign-in with a redirect_uri_mismatch.
# Set this to the exact origin the app is actually reachable at.
AUTH_URL="http://localhost:3001"
# AUTH_URL="https://www.myludo.life"   (production)

# Also needed in production on any host that isn't Vercel/Cloudflare Pages
# (e.g. Railway) — tells Auth.js to trust the proxy's host header. (Setting
# AUTH_URL above already implies this, but it's harmless to set explicitly.)
# AUTH_TRUST_HOST="true"

# Uropai (https://dashboard.uropai.in/developer) — required for the Game
# Pack / Monthly / Annual purchase flow (src/app/api/billing/*). Use the
# TEST-environment key pair for local dev; PRODUCTION keys require KYC
# approval on the account. Which key signs a request determines which
# environment (TEST vs PRODUCTION) it's routed to. Confirmed against a real
# webhook delivery: this same secret signs both outgoing requests and
# incoming webhooks (registered against POST <origin>/api/billing/uropai/
# webhook, also passed explicitly as `webhookUrl` on order creation) — the
# separate secret issued under Settings > Webhooks does NOT sign webhooks
# despite appearances; don't use it here.
UROPAI_API_KEY=""
UROPAI_API_SECRET=""

# Only needed when this differs from AUTH_URL — Uropai requires an HTTPS
# origin for its returnUrl/webhookUrl, which AUTH_URL isn't guaranteed to be
# (e.g. local dev usually pins AUTH_URL to http://localhost to match the
# registered Google OAuth redirect URI). Point this at an https tunnel (e.g.
# ngrok) for local billing testing; omit it in production, where AUTH_URL
# already is the real https origin.
# UROPAI_PUBLIC_URL="https://<your-ngrok-subdomain>.ngrok-free.app"

# PostHog Cloud (https://posthog.com) project token, from Project Settings >
# API Keys. Not a secret — it's a write-only key already embedded in every
# page load — but pulled from an env var since it's account-specific.
# Funnel/monetization tracking (src/server/posthog.js,
# src/components/PosthogProvider.tsx) is gated to NODE_ENV=production, so
# these aren't required for local dev.
# HOST points at our managed reverse proxy (t.myludo.life) rather than
# us.i.posthog.com directly, so capture requests go first-party.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://t.myludo.life"
