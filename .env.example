# Postgres connection string. Provision with Railway's "Add Postgres" plugin
# in production (it injects DATABASE_URL automatically); for local dev, point
# at any Postgres instance (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`).
DATABASE_URL="postgresql://user:password@localhost:5432/ludo"

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Add these authorized redirect URIs:
#   http://localhost:3001/api/auth/callback/google   (local dev)
#   https://<your-domain>/api/auth/callback/google   (production)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Session/JWT signing secret. Generate with: openssl rand -base64 33
AUTH_SECRET=""

# Required — this app runs a custom Node server (server.js), not `next dev`/
# `next start` directly, and Next can't reliably derive its own origin from
# the raw request in that setup. Without this, Auth.js builds OAuth
# redirect/callback URLs from whatever Next falls back to internally, not
# the real one — breaking Google sign-in with a redirect_uri_mismatch.
# Set this to the exact origin the app is actually reachable at.
AUTH_URL="http://localhost:3001"
# AUTH_URL="https://www.myludo.life"   (production)

# Also needed in production on any host that isn't Vercel/Cloudflare Pages
# (e.g. Railway) — tells Auth.js to trust the proxy's host header. (Setting
# AUTH_URL above already implies this, but it's harmless to set explicitly.)
# AUTH_TRUST_HOST="true"

# Razorpay (https://dashboard.razorpay.com/app/keys) — required for the
# Game Pack / Monthly / Annual purchase flow (src/app/api/billing/*). Use
# the test-mode key pair for local dev. The webhook secret is set
# separately under Settings > Webhooks when you register the endpoint
# (POST <origin>/api/billing/razorpay/webhook) — it's not the same value
# as the account's API key secret.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
