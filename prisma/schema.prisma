generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) models, shaped for @auth/prisma-adapter ---

model User {
  id                  String        @id @default(cuid())
  name                String?
  email               String?       @unique
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime      @default(now())
  lastSeenAt          DateTime?
  inviteToken         String?       @unique
  accounts            Account[]
  sessions            Session[]
  profiles            UserProfile[]
  friendshipsSent     Friendship[]  @relation("FriendshipsSent")
  friendshipsReceived Friendship[]  @relation("FriendshipsReceived")
  entitlements        Entitlement[]
  creditBatches       CreditBatch[]
  usageEvents         UsageEvent[]
  payments            Payment[]
  coupons             Coupon[]
  referralsMade       Referral[]    @relation("ReferralsMade")
  referralsReceived   Referral[]    @relation("ReferralsReceived")
  // Set the first (and only) time the flash-discount splash is shown to
  // this user — see src/app/api/splash/eligibility/route.ts. Durable and
  // cross-device, unlike the guest-side localStorage flag used before
  // sign-in.
  upgradeSplashShownAt DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Player profiles ---
//
// Google sign-in is the "device login" — it identifies who's holding the
// phone/browser, not who's playing. The actual players seated in a room are
// PlayerProfiles: lightweight, reusable identities keyed by email, so the
// same person's stats/history stay unified no matter which signed-in
// device seats them (e.g. a parent's phone seating the whole family, or the
// same kid playing from two different devices). UserProfile just tracks
// which profiles a given device-login has used before, for its picker.

model PlayerProfile {
  id          String        @id @default(cuid())
  name        String
  email       String        @unique
  createdAt   DateTime      @default(now())
  users       UserProfile[]
  gamePlayers GamePlayer[]
}

model UserProfile {
  userId    String
  profileId String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([userId, profileId])
}

// --- Friends ---
//
// Friendship is between Users (signed-in Google accounts) rather than
// PlayerProfiles — only a real account can receive/accept a request or show
// up as online. A row starts "pending" (sent by requester) and becomes
// "accepted" once the addressee accepts, or is deleted on decline/unfriend.
// A row created via a personal invite link skips straight to "accepted"
// since visiting that private link already is the mutual consent.

model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  addresseeId String
  status      String    @default("pending") // pending | accepted
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  requester   User      @relation("FriendshipsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User      @relation("FriendshipsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// --- Game history ---

model Game {
  id           String       @id @default(cuid())
  roomCode     String
  maxPlayers   Int
  startedAt    DateTime
  endedAt      DateTime     @default(now())
  winnerSeatId String?
  // True when the host stopped the game early (see engine.js's endGame)
  // rather than it finishing naturally — whoever hadn't already finished
  // gets isWinner: false / placement: null on their GamePlayer row (not a
  // loss), and the history page reads this flag to label it "Ended early"
  // instead of "Lost" for those rows.
  endedEarly   Boolean      @default(false)
  players      GamePlayer[]
}

model GamePlayer {
  id        String         @id @default(cuid())
  gameId    String
  seatId    String
  name      String
  armIndex  Int
  isWinner  Boolean        @default(false)
  // 1-indexed finishing rank (1st/2nd/3rd place, up to 3 winners) or the
  // total seat count for the one seat that never finished — see
  // game.placements / placementFor() in src/game/engine.js. Nullable only
  // for rows saved before this field existed.
  placement Int?
  // Cumulative milliseconds this seat spent disconnected over the whole
  // game (see rooms.js's handleSocketDisconnect/reconnectSeats). The
  // leaderboard excludes a seat with 5+ minutes of this from rating for
  // that game, win or loss, regardless of placement — see
  // src/app/leaderboard/page.tsx / src/lib/leaderboard.ts.
  disconnectedMs Int         @default(0)
  profileId String?
  game      Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  profile   PlayerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([gameId])
}

// --- Pricing & entitlements ---
//
// Usage is charged per distinct signed-in account (User), not per seat —
// one account can seat several PlayerProfiles in a single room:create call
// (e.g. a parent seating their whole family), and that's still one charge.
// The charge itself is decided by src/server/entitlements.js's
// resolveCharge(), in priority order: an active Entitlement (subscription,
// checked against its fair-use cap) -> today's free allowance for that
// player count -> a CreditBatch (Game Pack) -> blocked. "Today" is a fixed
// Asia/Kolkata midnight window computed at query time against UsageEvent,
// not a stored counter — see src/server/time.js.

model PricingConfig {
  id        String   @id @default(cuid())
  key       String   @unique // "active" — single row, read at request time
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  type      String // MONTHLY | ANNUAL
  startsAt  DateTime
  expiresAt DateTime
  paymentId String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Play Billing only — the latest known purchase token for this
  // subscription, used by the RTDN webhook to find which Entitlement a
  // renewal/cancellation notification belongs to (Google's purchase token
  // is the only handle we get back; there's no way to attach our own userId
  // at purchase time via the Digital Goods API). Null for Uropai rows.
  playPurchaseToken String? @unique

  @@index([userId, expiresAt])
}

model CreditBatch {
  id        String   @id @default(cuid())
  userId    String
  credits   Int
  remaining Int
  expiresAt DateTime
  paymentId String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model UsageEvent {
  id             String   @id @default(cuid())
  userId         String
  roomCode       String
  role           String // HOST | JOINER
  playerCount    Int
  source         String // SUBSCRIPTION | FREE | PACK
  creditBatchId  String?
  consumedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}

model Payment {
  id                String    @id @default(cuid())
  userId            String
  purpose           String // PACK | MONTHLY | ANNUAL
  amountInr         Int
  discountInr       Int       @default(0) // e.g. the Monthly->Annual upgrade credit, for audit/analytics
  // Which gateway settled this payment. UROPAI is every row created before
  // this field existed (the default) and every web purchase since. PLAY is
  // a Google Play Billing purchase from the Android TWA — see
  // src/lib/play-billing.ts. The two gateways' identifying fields below are
  // therefore both nullable: exactly one set is populated, matching provider.
  provider          String    @default("UROPAI")
  uropaiOrderId     String?   @unique
  tenantOrderRef    String?   @unique // idempotency key sent to Uropai when creating the order
  // Play Billing only, below. playPurchaseToken is the idempotency key
  // (Google issues one token per purchase/renewal) — see the verify route.
  playPurchaseToken String?   @unique
  playProductId     String? // e.g. "game_pack" or "premium_plan:monthly"
  playOrderId       String? // Google's GPA.xxxx order id, kept for support/refund lookups only
  status            String // CREATED | PAID | FAILED
  // The coupon selected at order-creation time, if any (see order/route.ts).
  // Not unique — a coupon can sit on more than one CREATED payment across
  // retries; only the one that actually settles marks the coupon REDEEMED
  // via Coupon.redeemedPaymentId, which is unique. Always null for Play
  // purchases — v1 ships flat pricing only on Android, see PricingPageClient.
  couponId          String?
  createdAt         DateTime  @default(now())
  verifiedAt        DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon            Coupon?   @relation(fields: [couponId], references: [id])

  @@index([userId, status])
  @@index([provider])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  type       String
  properties Json?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
}

// --- Coupons & referrals ---
//
// A user holds at most one *active* coupon at a time (see issueCoupon in
// src/lib/coupons.ts) — claiming or earning a new one voids whatever
// unclaimed coupon they already had, so campaigns never stack. A coupon is
// only ever applied by explicit user choice at checkout (see
// src/app/api/billing/uropai/order/route.ts) — nothing auto-discounts.

model Campaign {
  id              String    @id @default(cuid())
  key             String    @unique // e.g. "referral", "diwali2026" — also the code typed in for a CAMPAIGN coupon
  kind            String // REFERRAL | PROMO
  discountPercent Int
  // Fixed-amount override, used by the flash-discount splash's two
  // campaigns (see prisma/seed-campaigns.mjs) instead of discountPercent —
  // the target prices (₹49->₹33, ₹149->₹99) don't share a clean integer
  // percent, so a fixed ₹ amount is used when set. Null preserves the
  // existing percent-based behavior for every other campaign.
  discountInr     Int?
  // Restricts this campaign's coupons to one BillingPurpose (see
  // src/app/api/billing/uropai/order/route.ts) — required for the flash
  // campaigns since their fixed discountInr is only correct against the
  // one plan it was computed for. Null (the default for existing
  // campaigns) means unrestricted, matching today's behavior.
  restrictToPurpose String?
  active          Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  coupons         Coupon[]
}

model Coupon {
  id                String    @id @default(cuid())
  code              String    @unique
  campaignId        String
  ownerUserId       String
  role              String // CAMPAIGN | REFEREE_WELCOME | REFERRER_REWARD | FLASH_OFFER
  status            String    @default("ACTIVE") // ACTIVE | REDEEMED | VOIDED
  referralId        String?
  // Only set for FLASH_OFFER coupons — a real, per-issuance deadline (see
  // issueCoupon/getActiveCoupon in src/lib/coupons.ts). Null means no
  // expiry, same as every other coupon role today.
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  redeemedAt        DateTime?
  redeemedPaymentId String?   @unique
  voidedAt          DateTime?
  campaign          Campaign  @relation(fields: [campaignId], references: [id])
  owner             User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  referral          Referral? @relation(fields: [referralId], references: [id])
  payments          Payment[]

  @@index([ownerUserId, status])
}

model Referral {
  id         String    @id @default(cuid())
  referrerId String
  refereeId  String    @unique // one referral relationship per referred user, ever
  code       String // the inviteToken used to sign up
  status     String    @default("PENDING") // PENDING | REWARDED | VOIDED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  referrer   User      @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referee    User      @relation("ReferralsReceived", fields: [refereeId], references: [id], onDelete: Cascade)
  coupons    Coupon[]

  @@index([referrerId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String? // no FK, same pattern as AnalyticsEvent.userId — decoupled, non-critical data
  gameId    String?
  context   String // GAME_FINISHED | LEFT_EARLY
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())

  @@index([context, createdAt])
}
